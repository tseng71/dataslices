  "scenes": [
    {
      "id": "opening-city",
      "design_source": "docs/05-storyboard-wireframes-v3.md",
      "route": "/",
      "trigger": { "kind": "query", "value": "scene=opening-city" },
      "required_viewports": ["desktop", "mobile", "mobile-reduced"],
      "requirements": {
        "copy": ["消失的星空", "这是完整的猎户座吗？"],
        "visual_entities": ["固定猎户座天区", "仍可见的亮星骨架"],
        "encodings": ["星体位置编码天空坐标", "星点大小编码视星等"],
        "annotations": ["城市条件不是完整星空"],
        "controls": [],
        "motion": "滚动后同一坐标上的暗星返回",
        "reduced_motion": "直接切换到已批准的离散天空状态"
      },
      "assertions": [
        { "id": "opening-title", "kind": "text", "selector": "h1", "expected": "消失的星空" },
        { "id": "opening-count", "kind": "attribute", "selector": "[data-scene-id='opening-city']", "attribute": "data-visible-count", "expected": "7" }
      ]
    },
