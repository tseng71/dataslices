{
  "name": "chinese-buzzwords-story",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/build-stage4-data.mjs",
    "clean": "node scripts/clean-build.mjs",
    "dev": "vite dev --host 0.0.0.0",
    "check": "npm run data && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
