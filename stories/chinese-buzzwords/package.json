    "test:conformance": "node scripts/run-conformance.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "svelte": "5.56.8",
    "svelte-check": "^4.0.5",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=18.20.4"
  }
}
