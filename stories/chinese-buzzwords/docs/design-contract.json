{
  "schema_version": 1,
  "design_version": "04-analysis-specific-wordsets-v4",
  "contract_status": "frozen_after_user_confirmation",
  "frozen_on": "2026-07-29",
  "approval_basis": "用户确认 v4：每章只使用该分析真正需要的词集，词语在整篇中持续作为视觉材料。",
  "design_sources": [
    "docs/04-analysis-specific-wordsets-v4.md",
    "assets/keyframes/desktop-analysis-wordsets-v4.svg",
    "assets/keyframes/mobile-analysis-wordsets-v4.svg"
  ],
  "viewports": [
    { "id": "desktop", "width": 1440, "height": 900, "reduced_motion": false },
    { "id": "mobile", "width": 390, "height": 844, "reduced_motion": false },
    { "id": "mobile-reduced", "width": 390, "height": 844, "reduced_motion": true }
  ],
  "global_requirements": {
    "route": "/",
    "visual_noun": "可读的真实中文流行语，而不是无名圆点或通用卡片",
    "object_constancy": "140 个 term_id 各自只渲染一个稳定节点，章节切换只改变位置、显隐和编码",
    "population_rule": "每章人口由分析问题决定：策展约40、完整140、模板4、证据5、混写13",
    "rendered_population_rule": "每章实际带 visible 状态的词节点数量必须等于该章声明人口，不能只更新数字而留下上一章词集",
    "mobile_rule": "移动端保留同一叙事与词集，仅压缩为半屏固定舞台和底部词表抽屉",
    "data_discipline": [
      "年度名单位置不解释为热度排名",
      "字符长度不外推为整个中文社会的语言趋势",
      "无后续资料不解释为词语死亡",
      "仅把有来源说明的词连到后续变体或语域"
    ]
  },
  "scenes": [
    {
      "id": "field-intro",
      "trigger": { "kind": "step", "value": "field-intro" },
      "required_viewports": ["desktop", "mobile", "mobile-reduced"],
      "assertions": [
        { "id": "intro-stage", "kind": "attribute", "selector": ".word-stage", "expected": "data-scene-id=field-intro" },
        { "id": "intro-population", "kind": "attribute", "selector": ".word-stage", "expected": "data-population-count=40" },
        { "id": "stable-nodes", "kind": "count", "selector": ".word-stage .word-mark", "expected": 140 },
        { "id": "intro-copy", "kind": "text", "selector": ".intro-copy", "expected": "先别急着问一个词“死没死”" }
      ]
    },
    {
      "id": "field-color",
      "trigger": { "kind": "step", "value": "field-color" },
      "required_viewports": ["desktop", "mobile"],
      "assertions": [
        { "id": "color-stage", "kind": "attribute", "selector": ".word-stage", "expected": "data-scene-id=field-color" },
        { "id": "color-population", "kind": "attribute", "selector": ".word-stage", "expected": "data-population-count=40" },
        { "id": "yyds-present", "kind": "text", "selector": "[data-term='YYDS']", "expected": "YYDS" }
