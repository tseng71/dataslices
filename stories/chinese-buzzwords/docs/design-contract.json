  "global_requirements": {
    "route": "/",
    "visual_noun": "真实、可读、可选择的中文词语或短语",
    "object_constancy": "同一 term_id 在场景重排中保持身份，不替换成无名粒子",
    "palette_roles": {
      "current_term": "#d94835",
      "network_evidence": "#1769e0",
      "cross_register": "#0a8f75",
      "template_structure": "#7b4fd2",
      "missing_or_unknown": "#b8b0a4",
      "paper": "#fffaf0",
      "ink": "#1d1c19"
    },
    "accessibility": [
      "每个主图形有可访问名称和一句当前状态摘要",
      "颜色以外同时使用位置、线型、边框或文字标签",
      "触控目标至少 44 CSS px",
      "200% 放大时正文和控件不截断",
      "键盘焦点不因词语重排而丢失"
    ],
    "data_discipline": [
      "年度入选、实际使用、搜索关注、新闻或公共表达分别编码",
      "缺失不插值，也不解释为零或死亡",
      "未经 Stage 4 验证的迁移、寿命和派生数量不得进入发布数据",
      "榜单系列和方法变化直接标注"
    ]
  },
